DATABASE_URL="mysql://usuario:contraseña@localhost:3306/extramoda"

# ── Sesiones (JWT) ────────────────────────────────────────────────────────────
# Mínimo 32 caracteres cada uno. Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
REFRESH_TOKEN_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Orígenes exactos (separados por coma) desde los que el navegador llamará a la API.
# Despliegue con dos servicios Render: la URL del FRONTEND, p. ej.
#   CORS_ORIGIN=https://extramoda-frontend.onrender.com
# En desarrollo (frontend en Vite): http://localhost:5173
CORS_ORIGIN=http://localhost:5173

ADMIN_EMAIL=admin@extramoda.es
ADMIN_PASSWORD=

