// ─────────────────────────────────────────────────────────────────────────────
// Extramoda — Esquema de base de datos (MySQL 8 + Prisma)
// Convenciones: tablas en snake_case (@@map), campos id en camelCase (@map),
//              precios SIEMPRE como Decimal(10,2) — nunca Float.
// Ejecutar:  npx prisma migrate dev --name init
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ─────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  EDITOR
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AttributeType {
  SELECT // el valor se elige de una lista (talla, color)
  TEXT // texto libre (composición: 95% algodón, 5% elastano)
  NUMBER
}

enum AddressType {
  SHIPPING
  BILLING
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  TRANSFER
  CASH_ON_DELIVERY
  WALLET
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

// ── IDENTIDAD Y ACCESO ────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(191)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(80)
  lastName     String    @map("last_name") @db.VarChar(80)
  phone        String?   @db.VarChar(30)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(255)
  role         Role      @default(CUSTOMER)
  isVerified   Boolean   @default(false) @map("is_verified")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")

  addresses     Address[]
  cart          Cart?
  wishlistItems WishlistItem[]
  orders        Order[]
  reviews       Review[]
  sessions      Session[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([role, isActive])
  @@map("users")
}

/// Refresh tokens hasheados: permite revocar sesiones (un JWT stateless no se puede).
model Session {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?   @map("user_agent") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Address {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  type        AddressType @default(SHIPPING)
  label       String?     @db.VarChar(40)
  firstName   String      @map("first_name") @db.VarChar(80)
  lastName    String      @map("last_name") @db.VarChar(80)
  company     String?     @db.VarChar(120)
  line1       String      @db.VarChar(160)
  line2       String?     @db.VarChar(160)
  city        String      @db.VarChar(80)
  province    String      @db.VarChar(80)
  postalCode  String      @map("postal_code") @db.VarChar(16)
  countryCode String      @default("ES") @map("country_code") @db.Char(2)
  phone       String?     @db.VarChar(30)
  isDefault   Boolean     @default(false) @map("is_default")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, isDefault])
  @@map("addresses")
}

// ── CATÁLOGO ──────────────────────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(120)
  slug        String  @unique @db.VarChar(191)
  description String? @db.Text
  imageUrl    String? @map("image_url") @db.VarChar(255)
  parentId    String? @map("parent_id")
  position    Int     @default(0)
  isActive    Boolean @default(true) @map("is_active")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId, position])
  @@index([isActive])
  @@map("categories")
}

model Brand {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(120)
  slug        String  @unique @db.VarChar(191)
  logoUrl     String? @map("logo_url") @db.VarChar(255)
  description String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("brands")
}

/// Campañas estacionales ("Colección Primavera 2026") — relación N:M con orden.
model Collection {
  id           String    @id @default(cuid())
  name         String    @db.VarChar(120)
  slug         String    @unique @db.VarChar(191)
  description  String?   @db.Text
  heroImageUrl String?   @map("hero_image_url") @db.VarChar(255)
  isPublished  Boolean   @default(false) @map("is_published")
  publishedAt  DateTime? @map("published_at")

  products CollectionProduct[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isPublished, publishedAt])
  @@map("collections")
}

model CollectionProduct {
  collectionId String @map("collection_id")
  productId    String @map("product_id")
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_products")
}

/// Catálogo de atributos: Color, Talla, Material, Corte… Evita columnas por talla
/// (S/M/L) y permite filtrar con una sola consulta genérica.
model Attribute {
  id           String        @id @default(cuid())
  name         String        @db.VarChar(80)
  slug         String        @unique @db.VarChar(80)
  type         AttributeType @default(SELECT)
  isFilterable Boolean       @default(true) @map("is_filterable")
  position     Int           @default(0)

  values   AttributeValue[]
  products ProductAttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String  @id @default(cuid())
  attributeId String  @map("attribute_id")
  label       String  @db.VarChar(80)
  value       String  @db.VarChar(120)
  hexColor    String? @map("hex_color") @db.VarChar(9) // solo para Color
  position    Int     @default(0)

  attribute         Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productAttributes ProductAttributeValue[]
  variantColors     ProductVariant[]        @relation("VariantColor")
  variantSizes      ProductVariant[]        @relation("VariantSize")

  @@index([attributeId, position])
  @@map("attribute_values")
}

model Product {
  id               String        @id @default(cuid())
  sku              String        @unique @db.VarChar(64)
  name             String        @db.VarChar(180)
  slug             String        @unique @db.VarChar(191)
  shortDescription String?       @map("short_description") @db.VarChar(300)
  description      String        @db.Text
  basePrice        Decimal       @map("base_price") @db.Decimal(10, 2)
  salePrice        Decimal?      @map("sale_price") @db.Decimal(10, 2)
  /// COALESCE(sale_price, base_price) desnormalizado.
  /// Existe porque MySQL ordena los NULL antes que los valores al hacer
  /// ORDER BY sale_price, y porque un filtro de rango sobre dos columnas
  /// (COALESCE) no puede usar índice. Mantenerlo aquí hace que ordenar y
  /// filtrar por precio sea un simple índice sobre una columna.
  /// IMPORTANTE: toda escritura de precio debe actualizarlo (helper
  /// `withCurrentPrice` en product.repository.js).
  currentPrice     Decimal       @map("current_price") @db.Decimal(10, 2)
  taxRate          Decimal       @default(0.21) @map("tax_rate") @db.Decimal(5, 2) // IVA 21 %
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false) @map("is_featured")
  weightGrams      Int?          @map("weight_grams")

  // Desnormalizados: se actualizan al crear/eliminar reseñas para no recalcular
  ratingAvg   Decimal @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount Int     @default(0) @map("rating_count")

  brandId     String?   @map("brand_id")
  categoryId  String?   @map("category_id")
  publishedAt DateTime? @map("published_at")

  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  variants        ProductVariant[]
  images          ProductImage[]
  attributes      ProductAttributeValue[]
  collectionItems CollectionProduct[]
  reviews         Review[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]
  coupons         CouponProduct[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([brandId])
  @@index([isFeatured, status])
  @@index([currentPrice])
  @@fulltext([name, description], map: "ft_products_name_description")
  @@map("products")
}

/// SKU por combinación real (p. ej. CAM-NEG-M). El stock SIEMPRE vive aquí,
/// nunca en Product: dos variantes pueden agotarse de forma independiente.
model ProductVariant {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  sku           String   @unique @db.VarChar(64)
  name          String?  @db.VarChar(120) // "Negro / M"
  barcode       String?  @unique @db.VarChar(64)
  price         Decimal  @db.Decimal(10, 2) // override; si null, usar product.basePrice
  salePrice     Decimal? @map("sale_price") @db.Decimal(10, 2)
  costPrice     Decimal? @map("cost_price") @db.Decimal(10, 2) // margen; nunca se expone al cliente
  stock         Int      @default(0)
  reservedStock Int      @default(0) @map("reserved_stock") // pedidos pendientes de pago
  isActive      Boolean  @default(true) @map("is_active")
  position      Int      @default(0)

  colorValueId String? @map("color_value_id")
  sizeValueId  String? @map("size_value_id")

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorValue AttributeValue? @relation("VariantColor", fields: [colorValueId], references: [id], onDelete: SetNull)
  sizeValue  AttributeValue? @relation("VariantSize", fields: [sizeValueId], references: [id], onDelete: SetNull)

  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId, isActive])
  @@index([colorValueId])
  @@index([sizeValueId])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  variantId String? @map("variant_id")
  url       String  @db.VarChar(255)
  altText   String? @map("alt_text") @db.VarChar(160)
  position  Int     @default(0)

  // Binario opcional. Las imágenes subidas por el admin se guardan aquí porque
  // el disco de Render Free se borra en cada reinicio; `url` apunta entonces a
  // /api/v1/images/:id. Las imágenes de seed usan url externa y data = null.
  data Bytes? @db.MediumBlob
  mime String? @db.VarChar(60)
  bytes Int?

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@index([variantId])
  @@map("product_images")
}

/// Imágenes del escaparate de inicio: las 2 fotos del hero y los fondos de las
/// categorías. Mismo criterio que ProductImage para el binario ( el disco de
/// Render Free se borra en cada reinicio), pero aquí el "hueco" lo identifica
/// `slot` ('hero-1', 'hero-2', 'category-jeans'…), que es ÚNICO: subir otra
/// foto al mismo slot reemplaza la anterior, así el panel no acumula imágenes
/// huérfanas cada vez que se cambia una.
model SiteImage {
  id        String   @id @default(cuid())
  slot      String   @unique @db.VarChar(60)
  url       String   @db.VarChar(255)
  altText   String?  @map("alt_text") @db.VarChar(160)
  data      Bytes?   @db.MediumBlob
  mime      String?  @db.VarChar(60)
  bytes     Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_images")
}

model ProductAttributeValue {
  productId   String @map("product_id")
  attributeId String @map("attribute_id")
  valueId     String @map("value_id")

  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value     AttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([productId, attributeId])
  @@index([valueId])
  @@map("product_attribute_values")
}

// ── CARRO Y LISTA DE DESEOS ───────────────────────────────────────────────────

model Cart {
  id        String    @id @default(cuid())
  userId    String    @unique @map("user_id")
  expiresAt DateTime? @map("expires_at") // para fusionar el carrito invitado al iniciar sesión

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String  @map("cart_id")
  productId String  @map("product_id")
  variantId String  @map("variant_id")
  quantity  Int     @default(1)
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2) // snapshot del precio al añadir

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

model WishlistItem {
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

// ── VENTAS ────────────────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  /// Legible por humanos: EXT-2026-00042. Se genera en el service, no con
  /// autoincrement (una columna AUTO_INCREMENT en MySQL debe ser clave y
  /// complica las migraciones).
  orderNumber String      @unique @map("order_number") @db.VarChar(24)
  userId      String      @map("user_id")
  status      OrderStatus @default(PENDING)

  email String  @db.VarChar(191)
  phone String? @db.VarChar(30)

  subtotal      Decimal @db.Decimal(10, 2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(10, 2)
  taxTotal      Decimal @default(0) @map("tax_total") @db.Decimal(10, 2)
  shippingTotal Decimal @default(0) @map("shipping_total") @db.Decimal(10, 2)
  grandTotal    Decimal @map("grand_total") @db.Decimal(10, 2)

  couponId   String? @map("coupon_id")
  couponCode String? @map("coupon_code") @db.VarChar(40) // snapshot por si el cupón se elimina

  /// Clave de idempotencia que envía el cliente en la cabecera
  /// `Idempotency-Key`. Es única POR USUARIO: si llega la misma clave dos veces
  /// (doble clic en "pagar", retry de red, dos pestañas) el checkout devuelve el
  /// pedido ya creado en lugar de crear un segundo pedido y descontar el stock
  /// otra vez. Es única compuesta y no una columna suelta porque dos usuarios
  /// distintos pueden generar la misma clave sin estorbarse.
  idempotencyKey String? @map("idempotency_key") @db.VarChar(64)

  /// Copia literal de la dirección: el historial de pedidos no debe cambiar
  /// si el cliente edita su dirección guardada.
  shippingAddress Json? @map("shipping_address")
  billingAddress  Json? @map("billing_address")

  notes        String?   @db.Text
  cancelReason String?   @map("cancel_reason") @db.VarChar(255)
  placedAt     DateTime  @default(now()) @map("placed_at")
  paidAt       DateTime? @map("paid_at")
  shippedAt    DateTime? @map("shipped_at")
  deliveredAt  DateTime? @map("delivered_at")
  cancelledAt  DateTime? @map("cancelled_at")

  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]
  payments  Payment[]
  shipments Shipment[]
  coupon    Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([userId, placedAt])
  @@index([status, placedAt])
  @@index([placedAt])
  /// Impide dos pedidos con la misma clave de idempotencia del mismo usuario.
  /// Es la garantía real: sin este índice único, dos checkouts simultáneos con la
  /// misma clave podrían pasar a la vez la comprobación previa y los dos insertar.
  @@unique([userId, idempotencyKey])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String @map("order_id")
  productId String @map("product_id")
  variantId String @map("variant_id")

  /// Snapshots: el pedido es un documento inmutable aunque el producto cambie.
  productName String  @map("product_name") @db.VarChar(180)
  variantName String? @map("variant_name") @db.VarChar(120)
  sku         String  @db.VarChar(64)
  imageUrl    String? @map("image_url") @db.VarChar(255)

  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)
  quantity      Int
  taxRate       Decimal @map("tax_rate") @db.Decimal(5, 2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(10, 2)
  lineTotal     Decimal @map("line_total") @db.Decimal(10, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @map("order_id")
  provider      String        @default("stripe") @db.VarChar(40)
  providerRef   String?       @map("provider_ref") @db.VarChar(120) // id de la sesión en Stripe
  method        PaymentMethod @default(CARD)
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("EUR") @db.Char(3)
  failureReason String?       @map("failure_reason") @db.VarChar(255)
  paidAt        DateTime?     @map("paid_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([provider, providerRef])
  @@map("payments")
}

model Shipment {
  id                String         @id @default(cuid())
  orderId           String         @map("order_id")
  carrier           String?        @db.VarChar(80)
  trackingNumber    String?        @map("tracking_number") @db.VarChar(80)
  trackingUrl       String?        @map("tracking_url") @db.VarChar(255)
  status            ShipmentStatus @default(PENDING)
  estimatedDelivery DateTime?      @map("estimated_delivery")
  shippedAt         DateTime?      @map("shipped_at")
  deliveredAt       DateTime?      @map("delivered_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

// ── PROMOCIONES ───────────────────────────────────────────────────────────────

model Coupon {
  id                   String       @id @default(cuid())
  code                 String       @unique @db.VarChar(40)
  description          String?      @db.VarChar(255)
  type                 DiscountType
  value                Decimal      @db.Decimal(10, 2) // % si es PERCENTAGE, € si es FIXED_AMOUNT
  minSubtotal          Decimal?     @map("min_subtotal") @db.Decimal(10, 2)
  maxDiscount          Decimal?     @map("max_discount") @db.Decimal(10, 2) // techo en cupones de %
  usageLimit           Int?         @map("usage_limit")
  usedCount            Int          @default(0) @map("used_count")
  perUserLimit         Int          @default(1) @map("per_user_limit")
  startsAt             DateTime?    @map("starts_at")
  expiresAt            DateTime?    @map("expires_at")
  isActive             Boolean      @default(true) @map("is_active")
  appliesToAllProducts Boolean      @default(true) @map("applies_to_all_products")

  products CouponProduct[]
  orders   Order[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, expiresAt])
  @@map("coupons")
}

model CouponProduct {
  couponId  String @map("coupon_id")
  productId String @map("product_id")

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
  @@map("coupon_products")
}

// ── CONTENIDO Y SOCIAL ────────────────────────────────────────────────────────

model Review {
  id                 String  @id @default(cuid())
  productId          String  @map("product_id")
  userId             String  @map("user_id")
  rating             Int // 1-5, validado con Zod
  title              String? @db.VarChar(120)
  comment            String? @db.Text
  isVerifiedPurchase Boolean @default(false) @map("is_verified_purchase")
  isApproved         Boolean @default(false) @map("is_approved") // moderación

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, userId]) // una reseña por usuario y producto
  @@index([productId, isApproved])
  @@map("reviews")
}

model NewsletterSubscriber {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(191)
  token        String    @unique @db.VarChar(80) // doble opt-in
  isSubscribed Boolean   @default(false) @map("is_subscribed")
  confirmedAt  DateTime? @map("confirmed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([isSubscribed])
  @@map("newsletter_subscribers")
}

model ContactMessage {
  id      String  @id @default(cuid())
  name    String  @db.VarChar(120)
  email   String  @db.VarChar(191)
  subject String  @db.VarChar(160)
  message String  @db.Text
  isRead  Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([isRead, createdAt])
  @@map("contact_messages")
}
